FROM node:20-alpine3.17 AS builder
WORKDIR /app
COPY ./ecom-fe/package.json package.json
COPY ./ecom-fe/yarn.lock yarn.lock
RUN yarn install --frozen-lockfile
COPY ./ecom-fe/ .
RUN yarn build:production

FROM nginx:alpine
COPY --from-builder /app/dist/ecom-fe/browser /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]